<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="GSBT.WinUI.Controls.CompressionScreenSaverOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GSBT.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Visibility="Collapsed"
    IsHitTestVisible="False">
    <UserControl.Resources>
        <ControlTemplate x:Key="VcrOutlineIconButtonTemplate" TargetType="controls:VcrOutlineIconButton">
            <Grid
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                MinWidth="{TemplateBinding MinWidth}"
                MinHeight="{TemplateBinding MinHeight}">
                <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Content}" />
            </Grid>
        </ControlTemplate>
        <Style TargetType="controls:VcrOutlineIconButton">
            <Setter Property="Template" Value="{StaticResource VcrOutlineIconButtonTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootGrid" Background="Transparent">
        <Border
            x:Name="VideoChromeBorder"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Padding="0"
            Background="Transparent"
            BorderBrush="{ThemeResource GsbtBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Border
                Background="#FF050608"
                CornerRadius="7"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <MediaPlayerElement
                    x:Name="VideoPlayer"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    AutoPlay="False"
                    AreTransportControlsEnabled="False"
                    Stretch="UniformToFill"
                    Opacity="1">
                    <MediaPlayerElement.RenderTransform>
                        <ScaleTransform x:Name="VideoPopTransform" ScaleX="0.94" ScaleY="0.94" />
                    </MediaPlayerElement.RenderTransform>
                </MediaPlayerElement>
            </Border>
        </Border>

        <StackPanel
            x:Name="ClockPanel"
            Margin="18,16,14,0"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            UseLayoutRounding="True"
            Opacity="0"
            Spacing="4">
            <controls:VcrOutlineTextBlock x:Name="ClockTimeLine" ClockFontSize="21" Text="PM 12:00:00" />
            <controls:VcrOutlineTextBlock x:Name="ClockDateLine" ClockFontSize="21" Text="JUN. 11 2026" />
        </StackPanel>

        <StackPanel
            x:Name="FileTrackerPanel"
            Margin="14,16,18,0"
            VerticalAlignment="Top"
            HorizontalAlignment="Right"
            UseLayoutRounding="True"
            Opacity="0"
            Spacing="4"
            Visibility="Collapsed">
            <controls:VcrOutlineTextBlock
                x:Name="FileTrackerUpcomingLine"
                HorizontalAlignment="Right"
                ClockFontSize="21"
                Text="" />
            <controls:VcrOutlineTextBlock
                x:Name="FileTrackerCurrentLine"
                HorizontalAlignment="Right"
                ClockFontSize="21"
                Text="" />
            <controls:VcrOutlineTextBlock
                x:Name="FileTrackerPreviousLine"
                HorizontalAlignment="Right"
                ClockFontSize="21"
                Text="" />
        </StackPanel>

        <controls:VcrOutlineTextBlock
            x:Name="CompressingStatusLine"
            Margin="0,0,0,12"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            ClockFontSize="21"
            Text="Compressing..."
            Opacity="0" />

        <StackPanel
            x:Name="ControlPanel"
            RequestedTheme="Dark"
            Margin="0,0,12,10"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="6"
            Opacity="0">
            <controls:VcrOutlineIconButton
                x:Name="MuteButton"
                IconGlyph="&#xE767;"
                IconFontSize="18"
                Click="MuteButton_Click"
                AccessKey="M"
                AutomationProperties.Name="Mute screen saver audio"
                ToolTipService.ToolTip="Mute screen saver audio (Alt+M)" />
            <controls:VcrOutlineIconButton
                x:Name="ExitButton"
                IconGlyph="&#xE8BB;"
                IconFontSize="16"
                Click="ExitButton_Click"
                AccessKey="X"
                AutomationProperties.Name="Exit screen saver"
                ToolTipService.ToolTip="Leave screen saver (Alt+X)" />
        </StackPanel>
    </Grid>
</UserControl>
